APP_URL=http://127.0.0.1:3000
# Production APP_URL must be the preferred HTTPS origin (no path).
# Optional Search Console HTML-tag token (content value only).
GOOGLE_SITE_VERIFICATION=
TURSO_DATABASE_URL=file:./sortify.db
# Hosted database: libsql://your-database.turso.io and its database token.
TURSO_AUTH_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Base64-encoded 32 random bytes, e.g. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
